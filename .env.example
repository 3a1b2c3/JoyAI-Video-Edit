# Optional conda activation. Leave unset if you activate the environment manually.
JOYAI_CONDA_SH=/path/to/conda/etc/profile.d/conda.sh
JOYAI_CONDA_ENV=joyai-video-edit

# Optional OpenAI-compatible prompt-enhancement endpoint.
# Do not commit real keys.
PE_API_KEY=
PE_BASE_URL=https://your-openai-compatible-endpoint/v1
PE_MODEL=

# Optional runtime overrides.
JOYAI_HOST=0.0.0.0
JOYAI_PORT=8080
JOYOMNI_DEVICE=cuda:0
CUDA_VISIBLE_DEVICES=0

# Optional checkpoint overrides.
# JOYAI_CHECKPOINT_ROOT=/path/to/checkpoints
# JOYAI_DIT_CKPT=/path/to/joyai_video_edit_dit_0804.pth
# JOYAI_VAE_CKPT=/path/to/vae
# JOYAI_TEXT_ENCODER_CKPT=/path/to/MiMo-VL-7B-RL-2508
# JOYAI_FACE_DETECTOR_ONNX=/path/to/face_detection_yunet_2023mar.onnx
# JOYAI_PERSON_DETECTOR_ONNX=/path/to/yolov8n.onnx
