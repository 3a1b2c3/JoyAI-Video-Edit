deploy/deps/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# joyomni_ops native build artifacts (built from source; never commit binaries)
joyomni_ops/build/
*.so

# OS / editor
.DS_Store

# Runtime artifacts (recordings, server logs)
deploy/recordings/
deploy/server.log

# Local secrets / machine-specific launch settings
.env
.env.*
!.env.example
